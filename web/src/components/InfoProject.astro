---
import { REPO_URL } from "../consts"

const { info, prev, next } = Astro.props
const { theme = {} } = info
const { isDark = false } = theme

const button =
  "inline-flex flex-1 items-center justify-center rounded-lg px-3 py-1.5 text-xs font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2"
---

<div class="hidden sm:block absolute left-4 bottom-4 px-8 py-1 rounded-lg">
  <div class="font-bold mt-4 animate-fade-in-up">
    <a
      class="text-xs items-center flex gap-2 hover:scale-110 transition"
      href="/"
      aria-label="100 proyectos de JavaScript: volver al inicio"
    >
      <div class="flex flex-col text-center leading-none">
        <span
          class:list={[
            {
              "from-slate-400 to-slate-600": !isDark,
              "from-slate-100 via-slate-400 to-slate-500": isDark,
            },
            "tracking-tighter text-4xl px-1 bg-clip-text inline-block text-transparent bg-gradient-to-r",
          ]}>100</span
        >
        <span
          class:list={[
            isDark ? "text-white/80" : "text-black/80",
            "tracking-tighter text-slate-800 text-[14px]",
          ]}>proyectos</span
        >
      </div>

      <span class="rotate-6">
        <svg class="rounded" width="52" height="52" viewBox="0 0 630 630" aria-hidden="true">
          <rect width="630" height="630" fill="#f7df1e"></rect>
          <path
            d="m423.2 492.19c12.69 20.72 29.2 35.95 58.4 35.95 24.53 0 40.2-12.26 40.2-29.2 0-20.3-16.1-27.49-43.1-39.3l-14.8-6.35c-42.72-18.2-71.1-41-71.1-89.2 0-44.4 33.83-78.2 86.7-78.2 37.64 0 64.7 13.1 84.2 47.4l-46.1 29.6c-10.15-18.2-21.1-25.37-38.1-25.37-17.34 0-28.33 11-28.33 25.37 0 17.76 11 24.95 36.4 35.95l14.8 6.34c50.3 21.57 78.7 43.56 78.7 93 0 53.3-41.87 82.5-98.1 82.5-54.98 0-90.5-26.2-107.88-60.54zm-209.13 5.13c9.3 16.5 17.76 30.45 38.1 30.45 19.45 0 31.72-7.61 31.72-37.2v-201.3h59.2v202.1c0 61.3-35.94 89.2-88.4 89.2-47.4 0-74.85-24.53-88.81-54.075z"
          ></path>
        </svg>
      </span>
    </a>
  </div>
  <h1
    class:list={[
      isDark ? "text-yellow-400" : "text-yellow-600",
      "font-semibold animate-fade-in animate-delay-300 mt-2 text-base text-center tracking-tighter",
    ]}
  >
    #{info.number} - {info.title}
  </h1>
  <details class="group relative mt-1 animate-fade-in animate-delay-500">
    <summary
      class:list={[
        "inline-flex cursor-pointer list-none items-center gap-1 rounded text-xs font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden",
        isDark ? "text-white/90 focus-visible:outline-white" : "text-black/90 focus-visible:outline-black",
      ]}
    >
      <span
        class="inline-block transition group-open:rotate-90 motion-reduce:transition-none"
        aria-hidden="true">▸</span
      >
      Sobre el proyecto
    </summary>
    <div
      class:list={[
        "absolute bottom-0 left-full ml-2 w-80 rounded-xl p-4 text-left shadow-xl ring-1 backdrop-blur-md",
        isDark
          ? "bg-neutral-900/90 text-white ring-white/10"
          : "bg-white/90 text-slate-900 ring-black/10",
      ]}
    >
      <p class:list={["text-sm text-pretty", isDark ? "text-white/80" : "text-slate-700"]}>
        {info.description}
      </p>
      <h2 class="mt-3 text-xs font-semibold">Qué vas a aprender</h2>
      <ul class="mt-1.5 flex flex-wrap gap-1.5">
        {
          info.learnings.map((learning: string) => (
            <li
              class:list={[
                "rounded-md px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset",
                isDark
                  ? "bg-white/5 text-white/80 ring-white/15"
                  : "bg-gray-50 text-gray-600 ring-gray-200",
              ]}
            >
              {learning}
            </li>
          ))
        }
      </ul>
      <div class="mt-4 flex gap-2">
        <a
          href={`${REPO_URL}/tree/main/${info.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[button, "bg-yellow-300 text-black hover:bg-yellow-400 focus-visible:outline-yellow-300"]}
        >
          Ver código
        </a>
        {
          info.youtube && (
            <a
              href={info.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                button,
                "ring-1",
                isDark
                  ? "ring-white/20 hover:bg-white/10 focus-visible:outline-white"
                  : "ring-black/15 hover:bg-black/5 focus-visible:outline-black",
              ]}
            >
              Ver vídeo
            </a>
          )
        }
      </div>
      {
        (prev || next) && (
          <nav
            aria-label="Otros proyectos"
            class:list={[
              "mt-4 flex justify-between gap-3 border-t pt-3 text-xs",
              isDark ? "border-white/10 text-white/70" : "border-black/10 text-slate-600",
            ]}
          >
            {prev ? (
              <a class="hover:underline" href={`/${prev.slug}`}>
                ← #{prev.number} {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="text-right hover:underline" href={`/${next.slug}`}>
                #{next.number} {next.title} →
              </a>
            )}
          </nav>
        )
      }
    </div>
  </details>
  <a
    class:list={[
      "text-xs animate-fade-in animate-delay-800 hover:underline",
      isDark ? "text-white/90" : "text-black/90",
    ]}
    href="/">← Volver a los proyectos</a
  >
</div>
