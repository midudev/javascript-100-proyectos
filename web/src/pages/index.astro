---
import Layout from "../layouts/Layout.astro"
import Hero from "../components/Hero.astro"
import Projects from "../components/Projects.astro"
import Footer from "../components/Footer.astro"
import GitHubStar from "../components/GitHubStar.astro"
import { AUTHOR, PROJECTS, SITE_DESCRIPTION, SITE_NAME } from "../consts"

const siteURL = new URL("/", Astro.site).href

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE_NAME,
      url: siteURL,
      description: SITE_DESCRIPTION,
      inLanguage: "es",
      author: AUTHOR,
    },
    {
      "@type": "ItemList",
      name: `Proyectos de ${SITE_NAME}`,
      itemListElement: PROJECTS.filter((project) => !project.hidden).map(
        (project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: project.title,
          url: new URL(`/${project.slug}`, Astro.site).href,
        })
      ),
    },
  ],
}
---

<Layout
  title="100 proyectos de JavaScript gratis: código y vídeo | midudev"
  jsonLd={jsonLd}
>
  <main
    class="pt-12 min-h-screen flex gap-y-16 flex-col justify-between px-8 relative"
  >
    <div
      class="absolute inset-0 -z-10 h-full w-full bg-white bg-[linear-gradient(to_right,#f5f5f5,transparent_1px),linear-gradient(to_bottom,#f5f5f5,transparent_1px)] bg-[size:6rem_4rem]"
    >
      <div
        class="absolute bottom-0 left-0 right-0 top-0 bg-[radial-gradient(circle_500px_at_50%_200px,#fffdd0,transparent)]"
      >
      </div>
    </div>
    <GitHubStar />
    <Hero />
    <Projects />
    <Footer />
  </main>
</Layout>
